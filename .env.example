# ==============================================================================
# VelvetMotion AI - Production Environment Configuration (.env.example)
# All variables are optional with robust zero-crash fallbacks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pluggable AI Chat Backend (OpenAI-Compatible: vLLM, Ollama, RunPod, OpenAI)
# ------------------------------------------------------------------------------
# Target endpoint URL for chat completions (e.g. https://api.openai.com/v1/chat/completions)
AI_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
# Bearer API key for your AI chat server (or 'dummy' if running local vLLM/Ollama)
AI_CHAT_API_KEY=your_ai_chat_api_key_here
# LLM model name
AI_CHAT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Pluggable AI Video Generation Backend (ComfyUI / Diffusers / fal.ai / Luma)
# ------------------------------------------------------------------------------
# Target endpoint for rendering prompt-driven motion MP4s
AI_VIDEO_ENDPOINT=
# API key for the video rendering cluster
AI_VIDEO_API_KEY=

# ------------------------------------------------------------------------------
# 3. Persistent Database Storage (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase project URL (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Service Role Secret Key (for serverless bypass of RLS on backend routes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
# Public Anon Key (for browser-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 4. Monetization & Coinbase Commerce Webhooks
# ------------------------------------------------------------------------------
# Verified Creator Bitcoin Payout Wallet Address (Native SegWit Bech32)
NEXT_PUBLIC_BTC_PAYOUT_ADDRESS=bc1qjmf9u3cmrn59q5nqmzgkvrgy7exegnfmph999k
# Shared webhook secret from Coinbase Commerce Dashboard -> Settings -> Webhooks
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_commerce_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Local Server Port
# ------------------------------------------------------------------------------
PORT=3070
